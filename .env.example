# NVIDIA API - Using Llama 3.3 70B
NVIDIA_API_KEY=nvapi-your-key-here
MODEL_NAME=meta/llama-3.3-70b-instruct

# MongoDB Connection String (Atlas or Local)
# Local: mongodb://localhost:27017/mindmate
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/mindmate
MONGODB_URI=mongodb://localhost:27017/mindmate

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_key_here
LANGCHAIN_PROJECT=MindMate-AI

# FastAPI Security
SECRET_KEY=generate_using_secrets_module
ENVIRONMENT=development
